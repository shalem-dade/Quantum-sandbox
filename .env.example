# Copy to .env. Never commit the resulting file or put tokens in the frontend.
DATABASE_PATH=data/quantum-sandbox.sqlite3
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:4173,http://127.0.0.1:4173
COOKIE_SECURE=false
PORT=8000

# Real IBM access is opt-in and uses a provider account managed by the operator.
HARDWARE_ENABLED=false
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=
IBM_BACKENDS=
HARDWARE_ALLOWED_USER_IDS=
HARDWARE_DAILY_SHOTS=4096
HARDWARE_TOTAL_DAILY_SHOTS=16384
HARDWARE_MAX_SECONDS=60
